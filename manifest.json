{
  "manifest_version": 3,
  "name": "OIC Activity Stream Enhanced Viewer",
  "version": "1.5.1",
  "description": "Fast collapsible tree view for OIC Activity Stream, with cross-run search across all executions of an integration.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.oraclecloud.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.oraclecloud.com/*"
      ],
      "js": [
        "jszip.min.js",
        "iv-core.js",
        "iv-panel.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}